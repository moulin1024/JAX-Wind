# The reconstruction is document-first; these specifications and the frozen
# JAX implementation are source artifacts even when their suffixes match the
# broad local-output rules above. Cache rules follow the unignore so generated
# Python artifacts remain excluded.
!/doc/design/
!/doc/design/**
!/legacy/jax/
!/legacy/jax/**
/legacy/jax/**/__pycache__/
/legacy/jax/**/*.pyc
/legacy/jax/**/.pytest_cache/
/legacy/jax/**/.ruff_cache/

